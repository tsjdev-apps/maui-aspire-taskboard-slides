{
  "name": "maui-aspire-taskboard-slides",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "themes/tsjdevapps"
  ],
  "scripts": {
    "dev": "concurrently --kill-others -n EN,DE \"npm:dev:en\" \"npm:dev:de\"",
    "dev:en": "slidev decks/en.md --port 3030 --base /en/",
    "dev:de": "slidev decks/de.md --port 3031 --base /de/",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/preview.mjs",
    "typecheck": "vue-tsc --noEmit",
    "test": "node node_modules/@playwright/test/cli.js test",
    "export:en": "slidev export decks/en.md --output exports/taskboard-en.pdf",
    "export:de": "slidev export decks/de.md --output exports/taskboard-de.pdf",
    "export:en:dark": "slidev export decks/en.md --dark --output exports/taskboard-en-dark.pdf",
    "export:de:dark": "slidev export decks/de.md --dark --output exports/taskboard-de-dark.pdf",
    "theme:pack": "npm pack --workspace slidev-theme-tsjdevapps"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@slidev/cli": "53.0.0",
    "@slidev/client": "53.0.0",
    "@slidev/parser": "53.0.0",
    "@slidev/types": "53.0.0",
    "@types/file-saver": "2.0.7",
    "@types/node": "^24.19.2",
    "concurrently": "10.0.6",
    "playwright-chromium": "1.64.1",
    "typescript": "~6.0.3",
    "vue": "^3.5.42",
    "vue-tsc": "3.3.14"
  },
  "overrides": {
    "dompurify": "3.4.17",
    "image-size": "2.0.4",
    "floating-vue": "5.2.2"
  }
}
